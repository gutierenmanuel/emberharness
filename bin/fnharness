#!/usr/bin/env bash
# fnharness — Claude Code harness que corre sobre cualquier proveedor de LLM.
#
#   fnharness                          sesión interactiva con la cuenta predeterminada (o la última usada)
#   fnharness --resume <session_id>    retoma una sesión
#   fnharness --account llamacpp       arranca con una cuenta concreta (no se guarda)
#   fnharness --account ollama --model qwen3:8b -p "resume este repo"
#   fnharness --perfil minimo          arranca con un perfil de contexto (full, simple, minimo o uno propio en profiles/)
#   fnharness --accounts               lista las cuentas, la predeterminada y la última usada
#   fnharness --set-default qwen36 [modelo]   fija la cuenta (y modelo) con la que abre; "last" = volver a la última usada
#
# Estado propio en ~/.fnharness (configuración, sesiones, cuentas, claves), separado de ~/.claude.
# Cualquier argumento no reconocido pasa tal cual al CLI.
set -euo pipefail

app="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
cli="$app/cli"

# Un TMUX heredado (p. ej. una ventana de kitty abierta desde dentro de tmux) hace creer
# a la TUI que sigue en tmux: copia al buffer de tmux y envuelve el OSC 52 en una
# secuencia que kitty pinta como texto. Dentro de tmux de verdad TERM es screen*/tmux*.
if [[ -n "${TMUX:-}" && "${TERM:-}" != screen* && "${TERM:-}" != tmux* ]]; then
  unset TMUX TMUX_PANE
  [[ "${TERM_PROGRAM:-}" == tmux ]] && unset TERM_PROGRAM TERM_PROGRAM_VERSION
fi

export CLAUDE_CONFIG_DIR="${CLAUDE_CONFIG_DIR:-$HOME/.fnharness}"
mkdir -p "$CLAUDE_CONFIG_DIR"

# Primera vez: registrar el statusbar propio (no pisa un settings.json existente).
settings="$CLAUDE_CONFIG_DIR/settings.json"
if [[ ! -f "$settings" ]]; then
  printf '{\n  "statusLine": {"type": "command", "command": "%s/statusline.sh", "padding": 1, "refreshInterval": 2}\n}\n' "$app" > "$settings"
fi

# --account se acepta en cualquier posición: el lanzador de las terminales de Matrix lo
# añade detrás de --dangerously-skip-permissions, --session-id, etc., y el CLI no lo conoce.
# --perfil se acepta igual y se reenvía al CLI (el lanzador lo recuerda para relanzarlo).
perfil_arg=""
rest=()
while [[ $# -gt 0 ]]; do
  case "$1" in
    --account)   export CLAUDE_MULTIMODEL_ACCOUNT="${2:?--account requiere valor}"; shift 2 ;;
    --account=*) export CLAUDE_MULTIMODEL_ACCOUNT="${1#--account=}"; shift ;;
    --perfil)    perfil_arg="${2:?--perfil requiere valor}"; shift 2 ;;
    --perfil=*)  perfil_arg="${1#--perfil=}"; shift ;;
    *)           rest+=("$1"); shift ;;
  esac
done
set -- ${rest[@]+"${rest[@]}"}

accounts_file="$CLAUDE_CONFIG_DIR/accounts.json"
# Cuentas conocidas: claude, los presets de proveedor (los de fábrica y los de providers.json del
# usuario) y las guardadas en accounts.json. Cada fuente es opcional: si una falta o no casa nada,
# las demás se siguen listando (con set -e un grep sin coincidencias cortaba el bloque entero).
known_accounts() {
  {
    echo claude
    local f
    for f in "$app/src/config/defaults/providers.json" "$CLAUDE_CONFIG_DIR/providers.json"; do
      [[ -f "$f" ]] && { jq -r '(.providers // {}) | keys[]' "$f" 2>/dev/null | grep -vx custom || true; }
    done
    [[ -f "$accounts_file" ]] && jq -r '(.accounts // {}) | keys[]' "$accounts_file" 2>/dev/null || true
  } | awk '!seen[$0]++'
}
store_field() { [[ -f "$accounts_file" ]] && jq -r --arg f "$1" '.[$f] // empty' "$accounts_file" 2>/dev/null || true; }

# Cuenta con la que abrirá la próxima sesión sin --account: predeterminada (si existe), si no la última usada.
startup_account() {
  local def last
  def="$(store_field default)"; last="$(store_field active)"
  if [[ -n "$def" ]] && known_accounts | grep -qx -- "$def"; then echo "$def|predeterminada"
  else echo "${last:-claude}|última usada"; fi
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --model)       export CLAUDE_MULTIMODEL_MODEL="$2"; shift 2 ;;
    --small-model) export CLAUDE_MULTIMODEL_SMALL_MODEL="$2"; shift 2 ;;
    --base-url)    export CLAUDE_MULTIMODEL_BASE_URL="$2"; shift 2 ;;
    --api-key)     export CLAUDE_MULTIMODEL_API_KEY="$2"; shift 2 ;;
    --accounts)
      def="$(store_field default)"; last="$(store_field active)"
      while read -r id; do
        tags=""
        [[ "$id" == "$def" ]] && tags=" (predeterminada)"
        [[ "$id" == "$last" ]] && tags="$tags (última usada)"
        echo "$id$tags"
      done < <(known_accounts)
      IFS='|' read -r sid ssrc <<< "$(startup_account)"
      echo "Al abrir: $sid ($ssrc)"
      exit 0 ;;
    --set-default)
      id="${2:?--set-default requiere una cuenta (o "last")}"; shift 2
      model=""; [[ $# -gt 0 && "$1" != -* ]] && { model="$1"; shift; }
      command -v jq >/dev/null || { echo "fnharness: --set-default necesita jq" >&2; exit 1; }
      [[ -f "$accounts_file" ]] || echo '{"accounts":{}}' > "$accounts_file"
      tmp="$accounts_file.tmp.$$"
      if [[ "$id" == last || "$id" == none ]]; then
        jq 'del(.default)' "$accounts_file" > "$tmp"
        msg="Sin cuenta predeterminada: se abrirá con la última usada."
      else
        known_accounts | grep -qx -- "$id" || { echo "fnharness: cuenta desconocida \"$id\". Mira: fnharness --accounts" >&2; exit 1; }
        jq --arg id "$id" --arg m "$model" '.default = $id | if $m != "" and $id != "claude" then .accounts[$id].model = $m else . end' "$accounts_file" > "$tmp"
        msg="Cuenta predeterminada: $id${model:+ (modelo $model)}. Se usa al abrir salvo --account."
      fi
      chmod 600 "$tmp" && mv "$tmp" "$accounts_file"
      echo "$msg"
      exit 0 ;;
    -h|--help)     sed -n '2,13p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) break ;;
  esac
done

# Lista de to-dos (TaskCreate/TaskList) por proyecto, no por sesión: el id sale del repo git
# principal del directorio de arranque (git-common-dir, así sus worktrees comparten lista) y la
# lista sobrevive al cerrar la sesión. Fuera de git, o con FNHARNESS_TASK_LIST_PER_SESSION=1,
# vuelve a ser por sesión. Un CLAUDE_CODE_TASK_LIST_ID explícito manda. Skill: to_dos.
if [[ -z "${CLAUDE_CODE_TASK_LIST_ID:-}" && "${FNHARNESS_TASK_LIST_PER_SESSION:-}" != 1 ]]; then
  if common="$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null)"; then
    proj="$(dirname "$common")"
    hash="$(printf '%s' "$proj" | sha1sum | cut -c1-8)"
    name="$(basename "$proj" | tr -c 'A-Za-z0-9_-' '_')"
    export CLAUDE_CODE_TASK_LIST_ID="proj-${name%_}-$hash"
  fi
fi

if [[ ! -x "$cli" ]]; then
  echo "fnharness: compilando por primera vez..." >&2
  (cd "$app" && PATH="$HOME/.local/bun-npm/node_modules/.bin:$PATH" bun install && bun run build) >&2
fi
# Por defecto la sesión arranca en bypassPermissions (aviso de seguridad la primera vez y
# pie en rojo). Un --permission-mode explícito manda; FNHARNESS_NO_BYPASS=1 arranca en
# modo simple y saca bypass del ciclo de Shift+Tab.
extra=()
if [[ "${FNHARNESS_NO_BYPASS:-}" != 1 ]]; then
  extra+=(--allow-dangerously-skip-permissions)
  [[ " $* " == *" --permission-mode "* || " $* " == *" --permission-mode="* ]] ||
    extra+=(--permission-mode bypassPermissions)
fi

# Con -p, o con FNHARNESS_NO_RESTART=1, el CLI sustituye al lanzador (sin bucle ni señales de por medio).
if [[ " $* " == *" -p "* || " $* " == *" --print "* || "${FNHARNESS_NO_RESTART:-}" == 1 ]]; then
  [[ -n "$perfil_arg" ]] && extra+=(--perfil "$perfil_arg")
  exec "$cli" "${extra[@]}" "$@"
fi

# Bucle de reinicio: /perfil escribe $CLAUDE_CONFIG_DIR/restart/<pid del lanzador>.args (un argumento
# por línea) y sale con 75 cuando el perfil pedido no se puede aplicar en caliente (bare, hooks
# apagados → encendidos). Con ese código y ese fichero se relanza el CLI con esos argumentos
# (--resume <sesión> --perfil <x> [--account <c> --model <m>] [--chdir <dir>]); cualquier otra salida termina aquí.
export FNHARNESS_LAUNCHER_PID=$$
restart_file="$CLAUDE_CONFIG_DIR/restart/$$.args"
child=0
# Las señales dirigidas al lanzador (p. ej. un SIGTERM de la terminal) llegan al CLI.
trap '[[ "$child" -gt 0 ]] && kill -TERM "$child" 2>/dev/null' TERM
trap '[[ "$child" -gt 0 ]] && kill -HUP "$child" 2>/dev/null' HUP
# Ctrl+C ya llega al CLI por el grupo de procesos de la terminal; el lanzador solo debe sobrevivirlo
# (un manejador, no ignorarla: lo ignorado se hereda y el CLI dejaría de oír SIGINT).
trap ':' INT
while true; do
  args=("${extra[@]}")
  [[ -n "$perfil_arg" ]] && args+=(--perfil "$perfil_arg")
  args+=("$@")
  rm -f "$restart_file"
  # Sin control de trabajos un proceso en segundo plano pierde la entrada estándar: <&0 la conserva.
  "$cli" "${args[@]}" <&0 &
  child=$!
  # Un trap interrumpe wait: se repite hasta que el hijo termina de verdad.
  rc=0
  while :; do
    wait "$child" && rc=0 || rc=$?
    kill -0 "$child" 2>/dev/null || break
  done
  child=0
  if [[ "$rc" -eq 75 && -f "$restart_file" ]]; then
    mapfile -t restart_args < "$restart_file"
    rm -f "$restart_file"
    # Los argumentos del reinicio sustituyen a los de la sesión; --account, --model y --perfil
    # se reaplican como al arrancar.
    set --
    i=0
    while [[ $i -lt ${#restart_args[@]} ]]; do
      case "${restart_args[$i]}" in
        --account) export CLAUDE_MULTIMODEL_ACCOUNT="${restart_args[$((i + 1))]}"; i=$((i + 2)) ;;
        --model)   export CLAUDE_MULTIMODEL_MODEL="${restart_args[$((i + 1))]}"; i=$((i + 2)) ;;
        --perfil)  perfil_arg="${restart_args[$((i + 1))]}"; i=$((i + 2)) ;;
        # --chdir lo consume el lanzador (no llega al CLI): el CLI relanzado arranca en ese directorio.
        --chdir)
          if cd "${restart_args[$((i + 1))]}" 2>/dev/null; then :
          else echo "fnharness: --chdir ignorado, no existe '${restart_args[$((i + 1))]}'" >&2; fi
          i=$((i + 2)) ;;
        *)         set -- "$@" "${restart_args[$i]}"; i=$((i + 1)) ;;
      esac
    done
    continue
  fi
  rm -f "$restart_file"
  exit "$rc"
done
